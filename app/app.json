{
  "expo": {
    "name": "Coders Free",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "codersfree",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1A23",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1A23",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.codersfree.movil",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1A23",
          "image": "./assets/images/logo-robot.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Coders Free usa tus fotos para que elijas tu foto de perfil.",
          "cameraPermission": "Coders Free usa la cámara para que te tomes la foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#FF8A3D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5318edc3-2d1d-426b-8f88-2c387163c870"
      }
    },
    "owner": "vhaf"
  }
}
